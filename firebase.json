{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "*.test.js", "firebase-debug.log", "firebase-debug.*.log"]
