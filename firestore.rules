rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSpaceMember(spaceId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/spaces/$(spaceId))
        && exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid));
    }

    function canAccessGifticon(data) {
      return request.auth.uid == data.ownerId
        || (('spaceId' in data) && data.spaceId != null && isSpaceMember(data.spaceId));
    }

    // Shape guard for gifticon writes. Without this any signed-in caller — including
    // a member of a shared space — could inject arbitrary fields or a bogus
    // imageUrl. request.resource.data is the full post-write doc on both create
    // and update, so listing every allowed key here also pins the doc shape for
    // partial updates. The image itself lives in Storage; only its URL is here.
    function isValidGifticon(data) {
      return data.keys().hasOnly(['ownerId', 'name', 'brand', 'category', 'imageUrl',
          'expiresAt', 'isUsed', 'createdAt', 'barcode', 'amount', 'usedAt',
          'notificationIds', 'location', 'spaceId'])
        && data.ownerId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.brand is string && data.brand.size() > 0 && data.brand.size() <= 200
        && data.category in ['cafe', 'convenience', 'restaurant', 'culture', 'etc']
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2000
        && data.expiresAt is string && data.expiresAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.isUsed is bool
        && data.createdAt is string
        && (!('barcode' in data) || data.barcode == null
            || (data.barcode is string && data.barcode.size() <= 200))
        && (!('amount' in data) || data.amount == null || data.amount is number)
        && (!('usedAt' in data) || data.usedAt == null || data.usedAt is string)
        && (!('notificationIds' in data) || data.notificationIds is list)
        && (!('location' in data) || data.location == null
            || (data.location.keys().hasOnly(['latitude', 'longitude'])
                && data.location.latitude is number
                && data.location.longitude is number))
        && (!('spaceId' in data) || data.spaceId is string);
    }

    match /spaces/{spaceId} {
      // Anyone signed in can preview a space by id (invite links work before joining).
      allow get: if isSignedIn();
      // No collection scans — knowing the id is the invite; nobody can enumerate spaces.
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;

      match /members/{memberId} {
        allow get: if isSignedIn() && (request.auth.uid == memberId || isSpaceMember(spaceId));
        allow list: if isSignedIn() && isSpaceMember(spaceId);
        allow create: if isSignedIn()
          && request.auth.uid == memberId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['owner', 'member']
          && request.resource.data.keys().hasOnly(['uid', 'role', 'joinedAt']);
        allow update: if false;
        allow delete: if isSignedIn()
          && (request.auth.uid == memberId
              || (exists(/databases/$(database)/documents/spaces/$(spaceId))
                  && get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerId == request.auth.uid));
      }
    }

    // collectionGroup('members') queries (useMySpaces/subscribeToMySpaces) don't
    // match the nested rule above — Cloud Firestore only applies collection-group
    // access to rules written with a recursive wildcard. This mirrors the query's
    // own where('uid', '==', ...) filter so it stays provable without extra reads.
    match /{path=**}/members/{memberId} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /gifticons/{gifticonId} {
      allow read, delete: if isSignedIn() && canAccessGifticon(resource.data);
      // ownerId/spaceId are immutable on update — otherwise any member could
      // reassign a shared gifticon's ownerId to themselves, or move it into
      // a space they don't belong to, since canAccessGifticon alone only
      // checks the *existing* doc, never the incoming write.
      allow update: if isSignedIn()
        && canAccessGifticon(resource.data)
        && isValidGifticon(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('spaceId', null) == resource.data.get('spaceId', null);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidGifticon(request.resource.data)
        && (!('spaceId' in request.resource.data) || isSpaceMember(request.resource.data.spaceId));
    }
  }
}
